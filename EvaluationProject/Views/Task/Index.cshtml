 @using Web.Models

@model IEnumerable<TaskManager>

<h2>Task List</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Add New Task</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Task Name</th>
            <th>Description</th>
            <th>Start Date</th>
            <th>Due Date</th>
            <th>Category</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Id</td>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>@task.StartDate</td>
                <td>@task.DueDate</td>
                <td>@task.Category?.Name</td>

                <td>
                    <a asp-action="Update" asp-route-id="@task.Id" class="btn btn-primary">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
