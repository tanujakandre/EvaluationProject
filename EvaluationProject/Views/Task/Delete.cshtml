@using Web.Models.ViewModels
@model TaskVM

<h2>Delete Task</h2>

<h4>Are you sure you want to delete this?</h4>

<div>
    <dl class="row">
        @* <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@Model.tasks.Id</dd> *@

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.tasks.Title</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.tasks.Description</dd>

        <dt class="col-sm-2">Start Date</dt>
        <dd class="col-sm-10">@Model.tasks.StartDate</dd>

        <dt class="col-sm-2">Due Date</dt>
        <dd class="col-sm-10">@Model.tasks.DueDate</dd>

        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.tasks.Category.Name</dd>

    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="tasks.Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>