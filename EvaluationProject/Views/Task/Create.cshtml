@using Web.Models.ViewModels
@model TaskVM

<h2>Add New Task</h2>

<form asp-action="Create" method="post">


    <div class="form-group">
        <label asp-for="tasks.Title"></label>
        <input asp-for="tasks.Title" class="form-control" />
        <span asp-validation-for="tasks.Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="tasks.Description"></label>
        <input asp-for="tasks.Description" class="form-control" />
        <span asp-validation-for="tasks.Description" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="tasks.StartDate"></label>
        <input asp-for="tasks.StartDate" class="form-control" />
        <span asp-validation-for="tasks.StartDate" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="tasks.DueDate"></label>
        <input asp-for="tasks.DueDate" class="form-control" />
        <span asp-validation-for="tasks.DueDate" class="text-danger"></span>
    </div>

    <label>Category</label>
    <select asp-for="tasks.CategoryId" class="form-control">
        <option value="0">-- Select Category --</option>
        @foreach (var item in Model.CategoryList)
        {
            <option value="@item.Id">@item.Name</option>
        }
    </select>

    <br />

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}